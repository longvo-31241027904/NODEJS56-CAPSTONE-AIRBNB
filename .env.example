# Copy to .env and replace passwords. URL-encode passwords in DATABASE_URL.
NODE_ENV=development
IMAGE_STORAGE=local
DB_TLS_REQUIRED=false
DB_CA_CERT_PATH=
DB_CA_CERT_BASE64=
TRUST_PROXY_HOPS=0
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSET_SIGNING_KEY=
JWT_SECRET=
# Generate a private random JWT_SECRET with at least 32 bytes. Never commit it.
PUBLIC_URL=http://localhost:3069
UPLOAD_DIR=uploads/avatars
PORT=3069
CORS_ORIGINS=http://localhost:3000
MYSQL_PORT=3308
MYSQL_DATABASE=airbnb_capstone_local
MYSQL_USER=airbnb
MYSQL_PASSWORD=replace-local-db-password
MYSQL_ROOT_PASSWORD=replace-local-root-password
DATABASE_URL=mysql://airbnb:replace-local-db-password@127.0.0.1:3308/airbnb_capstone_local
# MySQL80 alternative: configure-local-mysql.ps1 updates .env interactively for port 3306.
# Test account must only have privileges on airbnb_capstone_test.
TEST_DATABASE_URL=
TEST_DB_ALLOW_WRITE=false
SEED_ALLOW_LOCAL=false
SEED_ADMIN_EMAIL=admin@example.test
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
