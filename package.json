{
  "name": "airbnb-backend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:smoke": "node scripts/smoke.mjs",
    "test:auth-users": "node scripts/test-auth-users.cjs",
    "db:verify": "node scripts/verify-local-db.cjs",
    "test:mysql": "node scripts/test-mysql.cjs",
    "test:db-target": "node --test scripts/database-target.test.cjs scripts/local-db-identity.test.cjs",
    "format": "prettier --write \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.{cjs,mjs,ps1,ts}\" \"*.{ts,json,yml}\" --ignore-unknown",
    "format:check": "prettier --check \"src/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.{cjs,mjs,ps1,ts}\" \"*.{ts,json,yml}\" --ignore-unknown",
    "check:postman": "node scripts/check-postman.cjs",
    "check:containers": "node scripts/check-containers.cjs",
    "cloud:prepare": "tsx scripts/cloud-prepare.ts",
    "cloud:start": "npm run cloud:prepare && node dist/main.js",
    "test:cloud-prep": "node scripts/test-cloud-preparation.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcrypt": "6.0.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.3",
    "cloudinary": "2.10.0",
    "dotenv": "17.2.3",
    "express-rate-limit": "8.7.2",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.16",
    "@nestjs/testing": "11.2.8",
    "@types/bcrypt": "6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "24.0.0",
    "prettier": "3.8.1",
    "prisma": "7.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@nestjs/platform-express": {
      "multer": "2.5.0"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.4.1"
    },
    "ajv": "8.18.0"
  }
}
